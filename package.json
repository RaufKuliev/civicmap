{
  "name": "civic-map",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/RaufKuliev/civicmap.git",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm data:validate && pnpm data:public && next build && pnpm static:aliases",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "baseline": "tsx scripts/baseline-report.ts",
    "data:validate": "tsx scripts/validate-data.ts && tsx scripts/validate-evidence.ts",
    "data:evidence": "tsx scripts/validate-evidence.ts",
    "data:coverage": "tsx scripts/coverage-report.ts",
    "data:diff": "tsx scripts/snapshot-diff.ts",
    "data:import": "tsx scripts/import-data.ts",
    "data:import:real": "python scripts/import-real-data.py",
    "data:import:statuses": "tsx scripts/import-official-statuses.ts",
    "data:fetch:map": "tsx scripts/fetch-map-source.ts",
    "data:territories": "tsx scripts/build-territories.ts",
    "data:changes": "tsx scripts/build-changes.ts",
    "data:public": "tsx scripts/build-public-indexes.ts",
    "static:check": "tsx scripts/check-static-export.ts",
    "static:check:subpath": "tsx scripts/check-static-export.ts --base-path=/civicmap",
    "static:serve": "tsx scripts/serve-export.ts",
    "static:aliases": "tsx scripts/build-static-aliases.ts",
    "release:audit": "tsx scripts/release-audit.ts",
    "release:check": "tsx scripts/release-check.ts"
  },
  "dependencies": {
    "lucide-react": "latest",
    "minisearch": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.2",
    "eslint-config-next": "latest",
    "fflate": "latest",
    "tsx": "latest",
    "typescript": "6.0.2",
    "vitest": "latest",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.17.0"
}
